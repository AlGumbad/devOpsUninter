import { useState } from "react";
import { CharacterArchetype, characterArchetypes } from "@/data/gameData";
import { GameEngine } from "@/components/game/GameEngine";
import { Swords, BookOpen, Play } from "lucide-react";

const Index = () => {
  const [selectedCharacter, setSelectedCharacter] = useState<CharacterArchetype | null>(null);
  const [gameStarted, setGameStarted] = useState(false);
  const [showRules, setShowRules] = useState(false);

  const handleStartGame = () => {
    if (selectedCharacter) {
      setGameStarted(true);
    }
  };

  const handleExitGame = () => {
    setGameStarted(false);
  };

  // Game is running
  if (gameStarted && selectedCharacter) {
    return <GameEngine character={selectedCharacter} onExit={handleExitGame} />;
  }

  return (
    <div className="min-h-screen bg-background flex flex-col">
      {/* Title Screen */}
      <header className="text-center py-12 border-b border-border">
        <p className="text-sm text-gold/70 font-display mb-2 animate-fade-in">
          ✦ Feito por Roderick Blacksmith ✦
        </p>
        <h1 className="text-4xl md:text-6xl font-display text-gold mb-2 tracking-wider">
          DARKNESS AGES
        </h1>
        <p className="text-lg text-muted-foreground font-body">
          The Lord and the Demons of Londinium
        </p>
        <div className="flex justify-center gap-2 mt-4">
          <span className="text-2xl">⚔️</span>
          <span className="text-2xl">🏰</span>
          <span className="text-2xl">🐉</span>
        </div>
      </header>

      <main className="flex-1 container mx-auto px-4 py-8">
        {/* Character Selection */}
        <section className="mb-8">
          <h2 className="text-2xl font-display text-center text-foreground mb-6">
            Choose Your Hero
          </h2>
          
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
            {characterArchetypes.map((char) => {
              const sprites: Record<string, string> = {
                barbarian: "⚔️",
                wizard: "🧙",
                ranger: "🏹",
                paladin: "🛡️",
                thief: "🗡️",
                monk: "👊",
                druid: "🌿",
                bard: "🎵",
              };

              return (
                <button
                  key={char.id}
                  onClick={() => setSelectedCharacter(char)}
                  className={`
                    p-4 rounded-lg border-2 transition-all text-center
                    ${selectedCharacter?.id === char.id
                      ? 'border-gold bg-gold/10 scale-105'
                      : 'border-border hover:border-gold/50 bg-card'}
                  `}
                >
                  <div className="text-4xl mb-2">{sprites[char.id]}</div>
                  <p className="font-display text-sm text-foreground">{char.name}</p>
                  <p className="text-xs text-muted-foreground mt-1">
                    HP {char.vitality} | ATK D{char.attackDie}
                  </p>
                </button>
              );
            })}
          </div>
        </section>

        {/* Selected Character Details */}
        {selectedCharacter && (
          <section className="mb-8 max-w-2xl mx-auto">
            <div className="bg-card border border-border rounded-lg p-6">
              <div className="flex items-start gap-4">
                <div className="text-5xl">
                  {selectedCharacter.id === "barbarian" && "⚔️"}
                  {selectedCharacter.id === "wizard" && "🧙"}
                  {selectedCharacter.id === "ranger" && "🏹"}
                  {selectedCharacter.id === "paladin" && "🛡️"}
                  {selectedCharacter.id === "thief" && "🗡️"}
                  {selectedCharacter.id === "monk" && "👊"}
                  {selectedCharacter.id === "druid" && "🌿"}
                  {selectedCharacter.id === "bard" && "🎵"}
                </div>
                <div className="flex-1">
                  <h3 className="font-display text-xl text-gold">{selectedCharacter.name}</h3>
                  <p className="text-sm text-muted-foreground mb-3">{selectedCharacter.description}</p>
                  <div className="grid grid-cols-2 gap-2 text-sm">
                    <div className="bg-secondary/50 rounded px-2 py-1">
                      <span className="text-muted-foreground">Attack:</span>{" "}
                      <span className="text-primary">{selectedCharacter.attack}</span>
                    </div>
                    <div className="bg-secondary/50 rounded px-2 py-1">
                      <span className="text-muted-foreground">Defense:</span>{" "}
                      <span className="text-foreground">{selectedCharacter.defense}</span>
                    </div>
                    <div className="bg-secondary/50 rounded px-2 py-1">
                      <span className="text-muted-foreground">Vitality:</span>{" "}
                      <span className="text-green-500">{selectedCharacter.vitality}</span>
                    </div>
                    {selectedCharacter.mana && (
                      <div className="bg-secondary/50 rounded px-2 py-1">
                        <span className="text-muted-foreground">Mana:</span>{" "}
                        <span className="text-arcane">{selectedCharacter.mana}</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              {/* Specials */}
              <div className="mt-4 pt-4 border-t border-border">
                <p className="text-xs text-muted-foreground mb-2">ABILITIES</p>
                <div className="flex flex-wrap gap-2">
                  {selectedCharacter.specials.map((special, i) => (
                    <span key={i} className="text-xs bg-gold/10 text-gold px-2 py-1 rounded">
                      {special}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}

        {/* Action Buttons */}
        <div className="flex justify-center gap-4">
          <button
            onClick={handleStartGame}
            disabled={!selectedCharacter}
            className="flex items-center gap-2 px-8 py-4 bg-primary text-primary-foreground font-display text-lg rounded-lg 
              hover:bg-primary/80 disabled:opacity-50 disabled:cursor-not-allowed transition-all
              hover:scale-105 active:scale-95"
          >
            <Play className="w-5 h-5" />
            START ADVENTURE
          </button>

          <button
            onClick={() => setShowRules(!showRules)}
            className="flex items-center gap-2 px-6 py-4 bg-secondary text-foreground font-display rounded-lg 
              hover:bg-secondary/80 transition-all"
          >
            <BookOpen className="w-5 h-5" />
            RULES
          </button>
        </div>

        {/* Rules Panel */}
        {showRules && (
          <div className="mt-8 max-w-2xl mx-auto bg-card border border-border rounded-lg p-6">
            <h3 className="font-display text-gold text-lg mb-4">How to Play</h3>
            <div className="space-y-4 text-sm text-muted-foreground">
              <div>
                <p className="text-foreground font-display mb-1">🎮 Controls</p>
                <p>Use <kbd className="bg-secondary px-2 rounded">WASD</kbd> or <kbd className="bg-secondary px-2 rounded">Arrow Keys</kbd> to move your character around the map.</p>
              </div>
              <div>
                <p className="text-foreground font-display mb-1">⚔️ Combat</p>
                <p>Walk into enemies to start combat. Roll dice to attack and defend! 
                   Your attack roll minus enemy's defense roll = damage dealt.</p>
              </div>
              <div>
                <p className="text-foreground font-display mb-1">🎲 Dice System</p>
                <p>+1D means upgrade your die (D4→D6→D8→D10→D12→D20). Rolling a 1 is always a miss!</p>
              </div>
              <div>
                <p className="text-foreground font-display mb-1">🗺️ Exploration</p>
                <p>Move to the edges of the map to travel between locations. Find NPCs and uncover the mystery!</p>
              </div>
            </div>
          </div>
        )}
      </main>

      {/* Footer */}
      <footer className="border-t border-border py-4 text-center">
        <p className="text-xs text-muted-foreground mb-1">
          A Darkness Ages Campaign • Medieval Londinium, 1100 A.D.
        </p>
        <p className="text-xs text-gold/60 font-display">
          ✦ Feito por Roderick Blacksmith ✦
        </p>
      </footer>
    </div>
  );
};

export default Index;
